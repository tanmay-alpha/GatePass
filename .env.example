# GatePass configuration. Copy to .env (never commit it).
# `npm start` / `npm run dev` load .env automatically; docker compose passes it
# to the container via env_file. Empty values are treated as unset.

# Required. Admin bearer token, at least 24 characters. Generate one with:
#   openssl rand -base64 32
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
ADMIN_TOKEN=

# Public origin encoded into every pass QR code as <APP_PUBLIC_URL>/p/<token>.
# In production this must be the public HTTPS origin, e.g. https://gate.example.com.
# Camera scanning on /scan needs HTTPS except on localhost.
APP_PUBLIC_URL=http://localhost:3000

# SQLite database file. Its directory also holds the -wal and -shm files and
# must be on persistent local disk. Docker compose overrides this to /data/gatepass.db.
DATABASE_FILE=.local/data/gatepass.db

# Bind address and port. Keep 127.0.0.1 outside containers; docker compose
# overrides HOST to 0.0.0.0 inside the container.
HOST=127.0.0.1
PORT=3000

# Express "trust proxy": number of reverse-proxy hops in front of the app (e.g. 1),
# or "loopback". Leave empty when clients connect directly. Required behind a
# proxy so rate limits apply per client instead of per proxy.
TRUST_PROXY=

# Built web UI served by the API process (output of `npm run build`).
CLIENT_DIR=dist/client

# Optional TLS termination in Node; normally terminate HTTPS at the proxy instead.
HTTPS_CERT_FILE=
HTTPS_KEY_FILE=

# `true` lets anyone create an organizer account from the sign-in screen.
# Default false: accounts come only from invitations (platform admins invite
# organizers; event owners invite managers).
ALLOW_SIGNUP=false

# `true` on deployments without durable storage (e.g. a free host with no
# persistent disk): the UI warns that all data can reset at any time.
DEMO_MODE=false

# Fronting CDN only (e.g. the Vercel split deployment): the CDN sends this value
# as X-Origin-Secret and requests without it are refused. At least 32 characters.
# CLIENT_IP_HEADER names the header carrying the visitor IP (Vercel:
# x-vercel-forwarded-for) and is only honoured together with ORIGIN_SECRET.
ORIGIN_SECRET=
CLIENT_IP_HEADER=

# docker compose `proxy` profile only: host name Caddy serves and obtains a
# certificate for. Must match the host in APP_PUBLIC_URL. Empty = localhost.
GATEPASS_DOMAIN=

# Vercel project settings (read by vercel.mjs at build time, not by the server).
# Production deployments (VERCEL_ENV=production) need:
#   GATEPASS_BACKEND_ORIGIN=https://api.gate.example.com
#   ORIGIN_SECRET=<same value as the production server's ORIGIN_SECRET>
# Preview deployments never use those. Without the two variables below a preview
# is static-only and /api/* and /p/* answer 503; with them it proxies to a
# separate non-production server:
#   GATEPASS_PREVIEW_BACKEND_ORIGIN=https://preview-api.gate.example.com
#   PREVIEW_ORIGIN_SECRET=<that server's ORIGIN_SECRET>

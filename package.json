{
  "name": "gatepass",
  "version": "0.1.0",
  "description": "QR-based event entry: issue passes, verify them at the door with authenticated scanners.",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env --disable-warning=ExperimentalWarning src/server/index.ts",
    "dev:web": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build && npm run build:server",
    "build:server": "vite build --ssr src/server/index.ts --outDir dist/server --emptyOutDir",
    "start": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning dist/server/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "smoke:qr": "tsx scripts/qr-smoke.ts",
    "bench": "tsx --disable-warning=ExperimentalWarning scripts/bench.ts",
    "load-test": "tsx --disable-warning=ExperimentalWarning scripts/load-test.ts"
  },
  "license": "MIT",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.4",
    "helmet": "^8.3.0",
    "qrcode": "^1.5.4",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@playwright/test": "^1.65.0",
    "@types/express": "^5.0.6",
    "@types/node": "^25.6.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^6.3.0",
    "barcode-detector": "^3.2.3",
    "lucide-react": "^1.72.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "supertest": "^7.3.2",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vite": "^8.3.8",
    "vitest": "^4.1.5",
    "zxing-wasm": "^3.1.6"
  },
  "overrides": {
    "esbuild": "^0.28.2"
  }
}

{
  "name": "gatepass",
  "version": "0.1.0",
  "description": "QR-based event entry: issue passes, verify them at the door with authenticated scanners.",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env --disable-warning=ExperimentalWarning src/server/index.ts",
    "dev:web": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "start": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning --import tsx src/server/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "smoke:qr": "tsx scripts/qr-smoke.ts"
  },
  "license": "MIT",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.3",
    "helmet": "^8.3.0",
    "qrcode": "^1.5.4",
    "tsx": "^4.21.0",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^25.6.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/supertest": "^7.2.0",
    "@vitejs/plugin-react": "^6.0.1",
    "barcode-detector": "^3.2.3",
    "lucide-react": "^1.14.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "supertest": "^7.2.2",
    "typescript": "^6.0.3",
    "vite": "^8.0.11",
    "vitest": "^4.1.5",
    "zxing-wasm": "^3.1.6"
  },
  "overrides": {
    "esbuild": "^0.28.2"
  }
}
